<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="90"
                android:startColor="#36151C27"
                android:centerColor="#241B2430"
                android:endColor="#48101720" />
            <stroke
                android:width="1dp"
                android:color="#A8FFFFFF" />
        </shape>
    </item>

    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="90"
                android:startColor="#3DFFFFFF"
                android:centerColor="#0FFFFFFF"
                android:endColor="#08000000" />
            <stroke
                android:width="1dp"
                android:color="#22FFFFFF" />
        </shape>
    </item>

    <item
        android:left="15dp"
        android:top="4dp"
        android:right="15dp"
        android:bottom="45dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#52FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

</layer-list>

+    public String syncV2Request(String endpoint, String json) {
+        HttpURLConnection connection = null;
+        try {
+            URL url = new URL(endpoint == null ? "" : endpoint.trim());
+            if (!"https".equalsIgnoreCase(url.getProtocol())) {
+                throw new IOException("Sync v2 принимает только HTTPS");
+            }
+            connection = (HttpURLConnection) url.openConnection();
+            connection.setConnectTimeout(15000);
+            connection.setReadTimeout(30000);
+            connection.setInstanceFollowRedirects(true);
+            connection.setRequestMethod("POST");
+            connection.setDoOutput(true);
+            connection.setUseCaches(false);
+            connection.setRequestProperty("Content-Type", "text/plain;charset=utf-8");
+            connection.setRequestProperty("Accept", "application/json");
+            byte[] bytes = (json == null ? "{}" : json).getBytes(StandardCharsets.UTF_8);
+            connection.setFixedLengthStreamingMode(bytes.length);
+            try (OutputStream output = connection.getOutputStream()) {
+                output.write(bytes);
+                output.flush();
+            }
+
+            int status = connection.getResponseCode();
+            InputStream stream = status >= 200 && status < 400
+                ? connection.getInputStream()
+                : connection.getErrorStream();
+            String body = readTextStream(stream);
+            if (status < 200 || status >= 400) {
+                return new JSONObject()
+                    .put("ok", false)
+                    .put("error", "Sync HTTP " + status + (body.isEmpty() ? "" : ": " + body))
+                    .toString();
+            }
+            if (body.trim().isEmpty()) throw new IOException("Сервер синхронизации вернул пустой ответ");
+            return body;
+        } catch (Exception error) {
+            try {
+                return new JSONObject()
+                    .put("ok", false)
+                    .put("error", readableSyncError(error))
+                    .toString();
+            } catch (Exception ignored) {
+                return "{\"ok\":false,\"error\":\"Ошибка Sync v2\"}";
+            }
+        } finally {
+            if (connection != null) connection.disconnect();
+        }
+    }
+
+    private String readTextStream(InputStream input) throws Exception {
+        if (input == null) return "";
+        try (InputStream source = input; ByteArrayOutputStream output = new ByteArrayOutputStream()) {
+            byte[] buffer = new byte[8192];
+            int count;
+            while ((count = source.read(buffer)) != -1) output.write(buffer, 0, count);
+            return output.toString(StandardCharsets.UTF_8.name());
+        }
+    }

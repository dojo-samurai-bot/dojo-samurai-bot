<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:contentDescription="@string/widget_name"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/content_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:id="@+id/zone_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="52">

            <TextClock
                android:id="@+id/time_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-condensed"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:letterSpacing="-0.025"
                android:maxLines="1"
                android:shadowColor="#72000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textColor="#F7FFF9"
                android:textSize="40sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/zone_center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="16" />

        <LinearLayout
            android:id="@+id/zone_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="32"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35" />

            <TextClock
                android:id="@+id/date_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="65"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif"
                android:format12Hour="EEE, d MMM.&#10;yyyy"
                android:format24Hour="EEE, d MMM.&#10;yyyy"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:lineSpacingExtra="-1dp"
                android:maxLines="2"
                android:shadowColor="#65000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="#F5FFF8"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
